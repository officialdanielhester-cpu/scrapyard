{
  "name": "ProjectVersion",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "snapshot": {
      "type": "object"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}