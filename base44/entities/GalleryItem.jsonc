{
  "name": "GalleryItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "essay",
        "audio",
        "song"
      ],
      "default": "image"
    },
    "prompt": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title",
    "kind"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}