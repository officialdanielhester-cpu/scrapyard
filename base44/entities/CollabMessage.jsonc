{
  "name": "CollabMessage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "default": "Anonymous"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "user_condition": {
        "role": "user"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}