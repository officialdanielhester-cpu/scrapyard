{
  "name": "GarmentVersion",
  "type": "object",
  "properties": {
    "design_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object"
        },
        "template_id": {
          "type": "string"
        },
        "design_name": {
          "type": "string"
        }
      }
    },
    "thumbnail": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "design_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}